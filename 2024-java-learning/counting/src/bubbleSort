    public static void bubbleSort(int[] array) {
        boolean doSwap; 

        do {
            doSwap = false;
            for (int i = 0; i < array.length - 1; i++) {
                if (array[i] > array[i + 1]) {
  
                    swapTwoArrayElements(array, i, i + 1);
                    doSwap = true; 
                }
            }
        } while (doSwap); 
    }

